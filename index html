<!DOCTYPE html>
<html>
<head>
    <style>
        .primary-btn {
            padding: 10px 20px;
            background-color: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            cursor: pointer;
        }

        .primary-btn:hover {
            background-color: #1e40af;
        }

        /* This targets the actual 'disabled' attribute */
        .primary-btn:disabled {
            background-color: #9ca3af;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

    <button class="primary-btn">Submit</button>
    
    <button class="primary-btn" disabled>Disabled</button>

</body>
</html>
